# Gemini AI
GEMINI_API_KEY=

# Google Maps Platform
VITE_GOOGLE_MAPS_API_KEY=

# Cloud SQL / PostgreSQL
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# Firebase Client Configuration (Optional environment variable overrides)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Express runtime configuration
PORT=3000
HOST=0.0.0.0

# Vite development-server host allowlist (comma-separated hostnames).
# Keep this list limited to exact hostnames; never use '*'.
VITE_ALLOWED_HOSTS=localhost,127.0.0.1
