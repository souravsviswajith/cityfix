# Server-only secrets. Never expose these through VITE_* variables.
GEMINI_API_KEY=

# Public browser configuration (the Maps key must be restricted by referrer/API).
VITE_GOOGLE_MAPS_API_KEY=

# Vite development-server host allowlist; comma-separated, not a secret.
VITE_ALLOWED_HOSTS=localhost,127.0.0.1

# Express runtime configuration.
PORT=3000
HOST=0.0.0.0
